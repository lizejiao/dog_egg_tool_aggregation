# 本地环境（copy 为 .env 生效）
# mock：全部算子走确定性假实现，零配置可跑（默认）
# live：接真实多模态大模型（需 uv sync --group live 并配 key）
AUDIT_MODE=mock

# live 模式的模型配置（兼容 OpenAI 协议的任意服务，如通义/DeepSeek/本地 vLLM）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
TEXT_MODEL=gpt-4o-mini

# LangSmith 追踪（可选；不配 key 则自动跳过，零开销）
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=listing-guard
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
