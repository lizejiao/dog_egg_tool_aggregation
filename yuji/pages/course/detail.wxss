/* 课程详情 */
.cd-hero {
  background-color: var(--primary-lighter);
  border-radius: 24rpx;
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
}

.cd-hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cd-hero__type {
  font-size: 24rpx;
  color: var(--primary-dark);
  letter-spacing: 2rpx;
}

.cd-hero__name {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.35;
}

.cd-hero__time {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: var(--primary-dark);
}

.cd-hero__meta {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--text-sub);
}

/* 名额 */
.cd-capacity {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(143, 166, 142, 0.18);
}

.cd-capacity__text {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.cd-capacity__remain {
  color: var(--primary-dark);
}

.cd-capacity__remain--full {
  color: var(--rose);
}

.cd-capacity__bar {
  height: 10rpx;
  background-color: rgba(143, 166, 142, 0.18);
  border-radius: 999rpx;
  overflow: hidden;
}

.cd-capacity__inner {
  height: 100%;
  background-color: var(--primary);
  border-radius: 999rpx;
}

/* 信息列表 */
.cd-info__item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.cd-info__label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-weak);
}

.cd-info__value {
  flex: 1;
  font-size: 27rpx;
  color: var(--text);
}

.cd-desc {
  font-size: 27rpx;
  color: var(--text-sub);
  line-height: 1.8;
}

/* 提示 */
.cd-tips {
  margin-top: 8rpx;
}

.cd-tips__title {
  font-size: 25rpx;
  color: var(--text-weak);
  margin-bottom: 10rpx;
}

.cd-tips__item {
  font-size: 24rpx;
  color: var(--text-weak);
  line-height: 1.9;
}

/* 底部剩余课时提示 */
.cd-remain-tip {
  display: flex;
  align-items: baseline;
  padding-left: 12rpx;
}

.cd-remain-tip__label {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 10rpx;
}

.cd-remain-tip__num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-dark);
  line-height: 1;
}

.cd-remain-tip__unit {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-left: 4rpx;
}
