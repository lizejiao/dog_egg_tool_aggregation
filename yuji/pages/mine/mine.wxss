/* 我的页面 */
.member-card {
  background: linear-gradient(150deg, #9DAF9B 0%, #8FA68E 55%, #7E9480 100%);
  border-radius: 28rpx;
  padding: 34rpx 30rpx;
  color: #FFFFFF;
  box-shadow: 0 10rpx 30rpx rgba(126, 148, 128, 0.22);
}

.member-card__top {
  display: flex;
  align-items: center;
}

/* 头像 */
.avatar-btn {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background-color: transparent;
  flex-shrink: 0;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -2rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  color: var(--primary-dark);
  font-size: 18rpx;
  text-align: center;
}

.member-info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.nickname-input {
  height: 52rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nickname-placeholder {
  color: rgba(255, 255, 255, 0.65);
  font-weight: 400;
}

.member-phone {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 手机号按钮（重置默认样式） */
.phone-btn {
  margin: 6rpx 0 0;
  padding: 0;
  background-color: transparent;
  border: none;
  border-radius: 0;
  font-size: 23rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.8);
  text-align: left;
}

.phone-btn::after {
  border: none;
}

.member-divider {
  height: 1rpx;
  background-color: rgba(255, 255, 255, 0.22);
  margin: 26rpx 0;
}

/* 剩余课时 */
.member-balance {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.member-balance__label {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.75);
}

.member-balance__num {
  margin-top: 6rpx;
  font-size: 62rpx;
  font-weight: 600;
  line-height: 1;
}

.member-balance__unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 8rpx;
  color: rgba(255, 255, 255, 0.8);
}

.member-balance__right {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
  padding-bottom: 6rpx;
}

.member-balance__right .arrow {
  font-size: 28rpx;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
  padding: 40rpx 0 10rpx;
  letter-spacing: 1rpx;
}
