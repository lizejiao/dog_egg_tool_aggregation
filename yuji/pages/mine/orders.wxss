/* 我的预约 */
.tabs {
  display: flex;
  background-color: var(--card);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tabs__item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 14rpx 0;
  border-radius: 16rpx;
}

.tabs__item--on {
  background-color: var(--primary-light);
  color: var(--primary-dark);
  font-weight: 600;
}

.od-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.od-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

.od-type {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-weak);
  margin-left: 12rpx;
}

.od-row {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.9;
}

.od-row--weak {
  font-size: 23rpx;
  color: var(--text-weak);
}

.od-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}
