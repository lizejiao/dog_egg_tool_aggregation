/* 我的课时套餐 */
.pk-summary {
  background: linear-gradient(150deg, #9DAF9B 0%, #8FA68E 55%, #7E9480 100%);
  border-radius: 28rpx;
  padding: 44rpx 34rpx;
  text-align: center;
  color: #FFFFFF;
  box-shadow: 0 10rpx 30rpx rgba(126, 148, 128, 0.22);
  margin-bottom: 36rpx;
}

.pk-summary__num {
  font-size: 76rpx;
  font-weight: 600;
  line-height: 1;
}

.pk-summary__unit {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 8rpx;
  color: rgba(255, 255, 255, 0.85);
}

.pk-summary__label {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* 已购套餐 */
.pk-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.pk-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.pk-progress {
  display: flex;
  align-items: center;
}

.pk-progress__bar {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background-color: #F1EFEC;
  overflow: hidden;
  margin-right: 20rpx;
}

.pk-progress__inner {
  height: 100%;
  border-radius: 999rpx;
  background-color: var(--primary);
}

.pk-progress__text {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-sub);
}

.pk-meta {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--text-weak);
}

/* 可购套餐 */
.pk-shop {
  display: flex;
  align-items: center;
}

.pk-shop__desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.pk-shop__meta {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 10rpx;
}

.pk-shop__right {
  flex-shrink: 0;
  margin-left: 24rpx;
  text-align: right;
}

.pk-shop__price {
  font-size: 36rpx;
  font-weight: 600;
  color: #A9817D;
  margin-bottom: 10rpx;
}
