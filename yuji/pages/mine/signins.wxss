/* 签到记录 */
.sg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sg-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text);
  margin-right: 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sg-type {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-weak);
  margin-left: 12rpx;
}

.sg-row {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.9;
}

.sg-row--weak {
  font-size: 23rpx;
  color: var(--text-weak);
}
