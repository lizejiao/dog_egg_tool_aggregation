/* 课程管理列表 */
.cl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.cl-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text);
  margin-right: 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cl-type {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-weak);
  margin-left: 12rpx;
}

.cl-row {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.9;
}

.cl-remain {
  color: var(--primary-dark);
}

.cl-foot {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
}
