/* 会员列表 */
.search {
  display: flex;
  align-items: center;
  background-color: var(--card);
  border-radius: 999rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  margin-bottom: 24rpx;
}

.search__input {
  flex: 1;
  font-size: 27rpx;
  height: 68rpx;
}

.search__btn {
  flex-shrink: 0;
  background-color: var(--primary-light);
  color: var(--primary-dark);
  font-size: 25rpx;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
}

.mb-item {
  display: flex;
  align-items: center;
}

.ml-16 {
  margin-left: 20rpx;
}

.mb-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background-color: var(--primary-lighter);
  color: var(--primary-dark);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mb-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  margin-right: 14rpx;
}

.mb-phone {
  font-size: 23rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}

.mb-balance {
  flex-shrink: 0;
  text-align: center;
  margin-left: 16rpx;
}

.mb-balance__num {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary-dark);
  line-height: 1.1;
}

.mb-balance__label {
  font-size: 20rpx;
  color: var(--text-weak);
}
