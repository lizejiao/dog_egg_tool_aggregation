/* 会员详情 */
.md-hero {
  background: linear-gradient(150deg, #9DAF9B 0%, #8FA68E 55%, #7E9480 100%);
  border-radius: 28rpx;
  padding: 32rpx 30rpx;
  color: #FFFFFF;
  box-shadow: 0 10rpx 30rpx rgba(126, 148, 128, 0.22);
  margin-bottom: 26rpx;
}

.md-hero__top {
  display: flex;
  align-items: center;
}

.md-hero__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.md-hero__info {
  margin: 0 20rpx;
}

.md-hero__name {
  font-size: 32rpx;
  font-weight: 600;
}

.md-hero__phone {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.md-hero__balance {
  display: flex;
  align-items: baseline;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}

.md-hero__num {
  font-size: 58rpx;
  font-weight: 600;
  line-height: 1;
}

.md-hero__unit {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 12rpx;
}

.md-actions {
  display: flex;
  gap: 18rpx;
}

.md-actions .btn {
  font-size: 26rpx;
  padding: 0 10rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.md-pkg {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.md-pkg:last-child {
  border-bottom: none;
}

.md-pkg__name {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}

.md-pkg__meta {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}

.tabs {
  display: flex;
  background-color: var(--card);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tabs__item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 14rpx 0;
  border-radius: 16rpx;
}

.tabs__item--on {
  background-color: var(--primary-light);
  color: var(--primary-dark);
  font-weight: 600;
}

.md-log__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.md-log__title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

.md-log__amount {
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.md-log__meta {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 6rpx;
}
