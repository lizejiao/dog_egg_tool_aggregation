/* 课时统计 */
.st-grid {
  display: flex;
}

.st-grid__item {
  flex: 1;
  text-align: center;
}

.st-grid__num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-dark);
  line-height: 1.15;
}

.st-grid__label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-weak);
}

/* 趋势图（纯 CSS 柱状） */
.st-trend {
  display: flex;
  align-items: flex-end;
  height: 220rpx;
  overflow-x: auto;
}

.st-trend__item {
  flex-shrink: 0;
  width: 60rpx;
  text-align: center;
  margin-right: 14rpx;
}

.st-trend__bar-wrap {
  height: 140rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.st-trend__bar {
  width: 26rpx;
  min-height: 6rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  background-color: var(--primary);
  opacity: 0.85;
}

.st-trend__date {
  font-size: 18rpx;
  color: var(--text-weak);
  margin-top: 8rpx;
  transform: scale(0.9);
}

.st-trend__count {
  font-size: 20rpx;
  color: var(--primary-dark);
}

/* 会员排行 */
.st-member {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.st-rank {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  background-color: #F1EFEC;
  color: var(--text-sub);
  font-size: 24rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.st-rank--top {
  background-color: var(--primary-light);
  color: var(--primary-dark);
  font-weight: 600;
}

.st-member__info {
  min-width: 0;
}

.st-member__name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  margin-right: 14rpx;
}

.st-member__phone {
  font-size: 22rpx;
  color: var(--text-weak);
}

.st-member__meta {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}
