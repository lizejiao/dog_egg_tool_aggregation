/* 首页 */
.hero {
  padding: 32rpx 8rpx 28rpx;
  position: relative;
}

.hero__hello {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 2rpx;
}

.hero__sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 剩余课时小卡片 */
.hero__card {
  position: absolute;
  right: 8rpx;
  bottom: 32rpx;
  display: flex;
  align-items: baseline;
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  background-color: var(--primary-light);
}

.hero__card-label {
  font-size: 22rpx;
  color: var(--primary-dark);
  margin-right: 12rpx;
}

.hero__card-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-dark);
  line-height: 1;
}

.hero__card-unit {
  font-size: 20rpx;
  color: var(--primary-dark);
  margin-left: 4rpx;
}

/* 公告条 */
.notice {
  display: flex;
  align-items: center;
  background-color: var(--card);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 30rpx;
}

.notice__badge {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #A9817D;
  background-color: var(--rose-light);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 18rpx;
}

.notice__swiper {
  flex: 1;
  min-width: 0;
  height: 40rpx;
}

.notice__item {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 40rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notice__arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: var(--text-weak);
  font-size: 30rpx;
  line-height: 1;
}

/* ==================== 馆主 / 超管视图 ==================== */

/* 概览头图（与后台风格一致） */
.ah-hero {
  background: linear-gradient(150deg, #9DAF9B 0%, #8FA68E 55%, #7E9480 100%);
  border-radius: 28rpx;
  padding: 34rpx 30rpx;
  color: #FFFFFF;
  box-shadow: 0 10rpx 30rpx rgba(126, 148, 128, 0.22);
  margin-bottom: 24rpx;
}

.ah-hero__title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.ah-hero__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.ah-stats {
  display: flex;
  margin-top: 28rpx;
  background-color: rgba(255, 255, 255, 0.14);
  border-radius: 20rpx;
  padding: 20rpx 0;
}

.ah-stats__item {
  flex: 1;
  text-align: center;
}

.ah-stats__num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
}

.ah-stats__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* 分组标题行（标题 + 链接） */
.group-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-title--flex {
  flex: 1;
}

.link {
  font-size: 24rpx;
  color: var(--primary);
  padding: 4rpx 8rpx;
}

/* 今日预约分组 */
.tg-group {
  padding: 8rpx 0;
}

.tg-group + .tg-group {
  border-top: 1rpx solid var(--border-light, #F1EFEC);
}

.tg-group__head {
  display: flex;
  align-items: center;
  padding: 16rpx 0 8rpx;
}

.tg-group__time {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary-dark, #79927A);
  margin-right: 16rpx;
}

.tg-group__name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tg-group__teacher {
  font-size: 22rpx;
  color: var(--text-sub);
  font-weight: 400;
}

.tg-group__count {
  font-size: 24rpx;
  color: var(--text-sub);
}

.tg-member {
  display: flex;
  align-items: center;
  padding: 12rpx 0 12rpx 46rpx;
  font-size: 25rpx;
}

.tg-member__name {
  color: var(--text);
}

.tg-member__phone {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.tg-member .tag {
  margin-left: auto;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
  padding: 40rpx 0 10rpx;
  letter-spacing: 1rpx;
}

/* ==================== 游客/学员视图：城市栏 + 场馆卡片 ==================== */

.city-bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 32rpx 8rpx 24rpx;
}

.city-bar__left {
  min-width: 0;
}

.city-bar__picker {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  margin-left: 16rpx;
  border-radius: 999rpx;
  background-color: #FFFFFF;
  font-size: 26rpx;
  color: var(--text);
  box-shadow: 0 4rpx 14rpx rgba(126, 148, 128, 0.12);
}

.city-bar__icon {
  margin-right: 6rpx;
  font-size: 24rpx;
}

.city-bar__arrow {
  margin-left: 8rpx;
  color: var(--text-sub);
  font-size: 20rpx;
}

/* 学员课时提示条 */
.balance-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--primary-light, #EDF2EC);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: var(--primary-dark, #79927A);
  margin-bottom: 24rpx;
}

.balance-bar__arrow {
  font-size: 28rpx;
}

/* 场馆卡片 */
.gym-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 22rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(126, 148, 128, 0.08);
}

.gym-card--hover {
  opacity: 0.85;
  transform: scale(0.99);
}

.gym-card__icon {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background-color: var(--primary-light, #EDF2EC);
  text-align: center;
  line-height: 92rpx;
  font-size: 44rpx;
}

.gym-card__body {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.gym-card__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gym-card__meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.gym-card__count {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.gym-card__addr {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gym-card__arrow {
  flex-shrink: 0;
  color: var(--text-weak);
  font-size: 36rpx;
}

/* ==================== 城市选择器弹层 ==================== */

.city-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 999;
}

.city-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx 30rpx 40rpx;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.city-panel__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  text-align: center;
  margin-bottom: 20rpx;
}

.city-panel__scroll {
  flex: 1;
  min-height: 0;
}

.city-panel__sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin: 10rpx 0 14rpx;
}

.city-panel__letter {
  font-size: 24rpx;
  color: var(--primary-dark, #79927A);
  font-weight: 600;
  margin: 20rpx 0 12rpx;
}

.city-grid {
  display: flex;
  flex-wrap: wrap;
}

.city-grid__item {
  width: 21%;
  margin: 1.5%;
  padding: 14rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--text);
  background-color: #F6F4F1;
  border-radius: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.city-grid__item--on {
  background-color: var(--primary, #8FA68E);
  color: #FFFFFF;
  font-weight: 600;
}

/* 已加入标记 */
.gym-card__joined-tag {
  display: inline-block;
  vertical-align: middle;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 19rpx;
  font-weight: 400;
  color: var(--primary-dark, #79927A);
  background-color: var(--primary-light, #EDF2EC);
  border-radius: 999rpx;
}

/* 超管：创建按钮 + 场馆行操作 */
.btn-primary {
  background-color: var(--primary, #8FA68E);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary::after {
  border: none;
}

.super-create-btn {
  margin: 10rpx 0 6rpx;
}

.form-tip-super {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
  margin-bottom: 20rpx;
}

.super-gym-row {
  border-bottom: 1rpx solid #F1EFEC;
}

.super-gym-row:last-child {
  border-bottom: none;
}

.super-gym-row__main {
  padding-right: 12rpx;
}

.super-gym-row__ops {
  display: flex;
  justify-content: flex-end;
  padding: 0 30rpx 20rpx;
}

.super-op {
  font-size: 23rpx;
  color: var(--primary-dark, #79927A);
  padding: 8rpx 22rpx;
  border: 1rpx solid var(--primary, #8FA68E);
  border-radius: 999rpx;
  margin-left: 16rpx;
}

.super-op--warn {
  color: #A9817D;
  border-color: #D9BDB9;
}

/* 加入申请卡片 */
.jr-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.jr-item + .jr-item {
  border-top: 1rpx solid #F1EFEC;
}

.jr-item__info {
  flex: 1;
  min-width: 0;
}

.jr-item__name {
  font-size: 28rpx;
  color: var(--text);
}

.jr-item__phone {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.jr-item__ops {
  display: flex;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.jr-btn {
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background-color: var(--primary, #8FA68E);
  color: #FFFFFF;
}

.jr-btn--ghost {
  background-color: transparent;
  color: var(--text-sub);
  border: 1rpx solid #DDD8D2;
}

.jr-btn + .jr-btn {
  margin-left: 14rpx;
}

/* 分组标题带徽标 */
.group-title {
  display: flex;
  align-items: center;
}

/* 授权馆主弹层 */
.op-gym-name {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-sub);
}

.op-loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 25rpx;
  color: var(--text-sub);
}

.op-user {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
}

.op-user--hover {
  background-color: #F9F8F6;
  border-radius: 14rpx;
}

.op-user + .op-user {
  border-top: 1rpx solid #F1EFEC;
}

.op-user__avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #F1EFEC;
}

.op-user__avatar--ph {
  text-align: center;
  line-height: 80rpx;
  font-size: 36rpx;
}

.op-user__info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.op-user__name {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text);
}

.op-user__name .tag {
  margin-left: 10rpx;
  flex-shrink: 0;
}

.op-user__phone {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.op-user__pick {
  flex-shrink: 0;
  font-size: 23rpx;
  color: #FFFFFF;
  background-color: var(--primary, #8FA68E);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

/* 场馆行的馆主信息 */
.super-owner-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.super-owner-name {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-bottom: 6rpx;
  max-width: 200rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 预约课程按钮（描边样式，弱于主操作） */
.super-op--plain {
  color: var(--primary-dark, #79927A);
  border-color: var(--primary-light, #D6E0D5);
  background-color: var(--primary-light, #EDF2EC);
}

/* 近期预约：按天分组标签 */
.tg-day {
  margin-bottom: 24rpx;
}

.tg-day__label {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-dark, #79927A);
  background-color: var(--primary-light, #EDF2EC);
  border-radius: 10rpx;
  padding: 6rpx 18rpx;
  margin-bottom: 14rpx;
}

