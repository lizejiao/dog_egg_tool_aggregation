/* 首页 */
.hero {
  padding: 32rpx 8rpx 28rpx;
  position: relative;
}

.hero__hello {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 2rpx;
}

.hero__sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 剩余课时小卡片 */
.hero__card {
  position: absolute;
  right: 8rpx;
  bottom: 32rpx;
  display: flex;
  align-items: baseline;
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  background-color: var(--primary-light);
}

.hero__card-label {
  font-size: 22rpx;
  color: var(--primary-dark);
  margin-right: 12rpx;
}

.hero__card-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-dark);
  line-height: 1;
}

.hero__card-unit {
  font-size: 20rpx;
  color: var(--primary-dark);
  margin-left: 4rpx;
}

/* 公告条 */
.notice {
  display: flex;
  align-items: center;
  background-color: var(--card);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 30rpx;
}

.notice__badge {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #A9817D;
  background-color: var(--rose-light);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 18rpx;
}

.notice__swiper {
  flex: 1;
  min-width: 0;
  height: 40rpx;
}

.notice__item {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 40rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notice__arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: var(--text-weak);
  font-size: 30rpx;
  line-height: 1;
}
